<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="/public/icons/favicon.ico" type="image/x-icon" />
  <style>
    :root {
      --bg-1: #0a0a1a;
      --accent-1: #7c3aed;
      --accent-2: #06b6d4;
      --accent-3: #ec4899;
      --text: #f1f5f9;
      --text-dim: #94a3b8;
      --glass: rgba(255, 255, 255, 0.05);
      --glass-border: rgba(255, 255, 255, 0.12);
      --radius: 20px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      min-height: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-1); color: var(--text);
    }

    .bg-orbs {
      position: fixed; inset: 0; z-index: -1; overflow: hidden;
      background: radial-gradient(ellipse at top, #1a0b3d 0%, #0a0a1a 65%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.5; animation: float 18s ease-in-out infinite; }
    .orb-1 { width: 480px; height: 480px; background: radial-gradient(circle, #7c3aed, transparent 70%); top: -140px; left: -100px; }
    .orb-2 { width: 400px; height: 400px; background: radial-gradient(circle, #06b6d4, transparent 70%); bottom: -100px; right: -100px; animation-delay: -7s; }
    .orb-3 { width: 340px; height: 340px; background: radial-gradient(circle, #ec4899, transparent 70%); top: 45%; left: 55%; animation-delay: -13s; }
    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(40px, -40px) scale(1.08); }
    }

    nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 6vw; backdrop-filter: blur(18px);
      background: rgba(10, 10, 26, 0.55);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      position: sticky; top: 0; z-index: 40;
      animation: slideDown 0.6s ease;
    }
    @keyframes slideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .logo {
      display: flex; align-items: center; gap: 12px;
      font-weight: 800; font-size: 1.25rem;
      text-decoration: none; color: #fff;
    }
    .logo-mark {
      width: 38px; height: 38px; border-radius: 11px;
      background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
      display: grid; place-items: center; font-size: 1.2rem;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
    }
    .nav-links a {
      color: var(--text-dim); text-decoration: none;
      padding: 9px 16px; border-radius: 10px;
      font-size: 0.92rem; font-weight: 500;
      transition: all 0.25s;
    }
    .nav-links a:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
    .nav-links a.active {
      color: #fff;
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.25), rgba(6, 182, 212, 0.25));
      border: 1px solid rgba(124, 58, 237, 0.4);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 40px 6vw 100px; }

    .page-head {
      margin-bottom: 36px;
      animation: fadeUp 0.6s ease both;
    }
    .page-head h1 {
      font-size: clamp(1.8rem, 3.5vw, 2.4rem);
      font-weight: 900; letter-spacing: -0.03em;
    }
    .page-head .grad {
      background: linear-gradient(120deg, #a78bfa, #06b6d4, #ec4899, #a78bfa);
      background-size: 300% 300%;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: gradientShift 6s ease-in-out infinite;
    }
    @keyframes gradientShift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .page-head p { color: var(--text-dim); font-size: 0.95rem; margin-top: 6px; }

    /* Search Bar */
    .search-bar {
      position: relative; margin-bottom: 24px;
      animation: fadeUp 0.6s 0.05s ease both;
    }
    .search-bar input {
      width: 100%; padding: 16px 20px 16px 52px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 14px;
      color: #fff; font-size: 1rem; font-family: inherit;
      outline: none;
      transition: all 0.28s ease;
      backdrop-filter: blur(18px);
    }
    .search-bar input:focus {
      border-color: var(--accent-1);
      background: rgba(124, 58, 237, 0.06);
      box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15);
    }
    .search-bar input::placeholder { color: rgba(148, 163, 184, 0.6); }
    .search-bar .ico {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      font-size: 1.15rem; opacity: 0.7;
      pointer-events: none;
    }

    /* Category Tabs */
    .cats {
      display: flex; gap: 8px; flex-wrap: wrap;
      margin-bottom: 24px;
      animation: fadeUp 0.6s 0.1s ease both;
    }
    .cat-btn {
      padding: 10px 20px; border-radius: 12px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      color: var(--text-dim);
      font-size: 0.88rem; font-weight: 600;
      cursor: pointer; font-family: inherit;
      transition: all 0.28s ease;
    }
    .cat-btn:hover { color: #fff; border-color: rgba(124, 58, 237, 0.4); }
    .cat-btn.active {
      color: #fff;
      background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
      border-color: transparent;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
    }

    /* Command Grid */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }

    .cmd-card {
      padding: 22px;
      border-radius: var(--radius);
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(18px);
      position: relative; overflow: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: fadeUp 0.5s ease both;
    }
    .cmd-card::after {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(124, 58, 237, 0.15), transparent 40%);
      opacity: 0; transition: opacity 0.4s;
      pointer-events: none;
    }
    .cmd-card:hover::after { opacity: 1; }
    .cmd-card:hover {
      transform: translateY(-6px);
      border-color: rgba(124, 58, 237, 0.45);
      box-shadow: 0 20px 50px rgba(124, 58, 237, 0.22);
    }

    .cmd-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 12px; gap: 10px;
    }
    .cmd-name {
      font-size: 1.1rem; font-weight: 800;
      letter-spacing: -0.01em;
      font-family: 'Courier New', monospace;
      color: #c4b5fd;
    }
    .cmd-cat {
      padding: 4px 10px; border-radius: 999px;
      font-size: 0.68rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em;
      background: rgba(124, 58, 237, 0.15);
      color: #c4b5fd;
      border: 1px solid rgba(124, 58, 237, 0.3);
      white-space: nowrap;
    }
    .cmd-desc {
      font-size: 0.88rem; color: var(--text-dim);
      line-height: 1.55; margin-bottom: 14px;
      min-height: 2.6em;
    }
    .cmd-usage {
      font-family: 'Courier New', monospace;
      font-size: 0.78rem;
      padding: 8px 12px;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: #86efac;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-bottom: 10px;
    }
    .cmd-tags {
      display: flex; gap: 6px; flex-wrap: wrap;
    }
    .tag {
      padding: 3px 9px; border-radius: 999px;
      font-size: 0.68rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-dim);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .tag.owner { background: rgba(236, 72, 153, 0.15); color: #f9a8d4; border-color: rgba(236, 72, 153, 0.3); }
    .tag.group { background: rgba(6, 182, 212, 0.15); color: #67e8f9; border-color: rgba(6, 182, 212, 0.3); }

    .empty-box {
      text-align: center; padding: 60px 20px;
      color: var(--text-dim);
      grid-column: 1 / -1;
    }
    .empty-box .ico { font-size: 3.6rem; opacity: 0.55; margin-bottom: 12px; }

    .stats-pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px; border-radius: 999px;
      background: rgba(124, 58, 237, 0.14);
      border: 1px solid rgba(124, 58, 237, 0.3);
      color: #c4b5fd; font-size: 0.85rem; font-weight: 700;
    }

    @media (max-width: 640px) {
      .nav-links a { padding: 8px 10px; font-size: 0.85rem; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <div class="bg-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <nav>
    <a href="/" class="logo">
      <div class="logo-mark">⚡</div>
      <span><%= botName %></span>
    </a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/sessions">Sessions</a>
      <a href="/commands" class="active">Commands</a>
      <a href="/status">Status</a>
      <a href="/pair">Pair</a>
    </div>
  </nav>

  <div class="container">

    <div class="page-head">
      <h1>Available <span class="grad">Commands</span></h1>
      <p>Browse all <span class="stats-pill">📦 <%= total %> commands</span> organized by category.</p>
    </div>

    <!-- Search -->
    <div class="search-bar">
      <span class="ico">🔍</span>
      <input type="text" id="searchInput" placeholder="Search commands... (name, description, or usage)" autocomplete="off" />
    </div>

    <!-- Categories -->
    <div class="cats" id="cats">
      <button class="cat-btn active" data-cat="all">📁 All</button>
      <% Object.keys(grouped).forEach((cat) => { %>
        <button class="cat-btn" data-cat="<%= cat %>">
          <%= cat === 'general' ? '📋' : cat === 'media' ? '🎨' : cat === 'group' ? '👥' : cat === 'utility' ? '🛠️' : cat === 'owner' ? '👑' : '📁' %>
          <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
          <span style="opacity:0.6;">(<%= grouped[cat].length %>)</span>
        </button>
      <% }) %>
    </div>

    <!-- Commands Grid -->
    <div class="grid" id="cmdGrid">
      <% commands.forEach((c) => { %>
        <div class="cmd-card"
             data-name="<%= c.name %>"
             data-cat="<%= c.category %>"
             data-desc="<%= c.description %>"
             data-aliases="<%= (c.aliases || []).join(',') %>"
             data-usage="<%= c.usage %>">
          <div class="cmd-head">
            <span class="cmd-name">.<%= c.name %></span>
            <span class="cmd-cat"><%= c.category %></span>
          </div>
          <div class="cmd-desc"><%= c.description || 'No description.' %></div>
          <% if (c.usage) { %>
            <div class="cmd-usage">⚡ .<%= c.usage %></div>
          <% } %>
          <div class="cmd-tags">
            <% if (c.ownerOnly) { %><span class="tag owner">👑 Owner</span><% } %>
            <% if (c.groupOnly) { %><span class="tag group">👥 Group</span><% } %>
            <% if (c.aliases && c.aliases.length) { %>
              <% c.aliases.slice(0, 3).forEach((a) => { %>
                <span class="tag">.<%= a %></span>
              <% }) %>
              <% if (c.aliases.length > 3) { %><span class="tag">+<%= c.aliases.length - 3 %></span><% } %>
            <% } %>
          </div>
        </div>
      <% }) %>

      <% if (!commands || !commands.length) { %>
        <div class="empty-box">
          <div class="ico">📦</div>
          <h3>No commands loaded</h3>
          <p>Commands will appear here once the bot loads them.</p>
        </div>
      <% } %>
    </div>

  </div>

  <script>
    // ============ FILTER ============
    const searchInput = document.getElementById('searchInput');
    const cats = document.getElementById('cats');
    const grid = document.getElementById('cmdGrid');
    let activeCat = 'all';

    function filter() {
      const q = (searchInput.value || '').toLowerCase().trim();
      let visible = 0;

      document.querySelectorAll('.cmd-card').forEach((card) => {
        const name = card.dataset.name || '';
        const desc = (card.dataset.desc || '').toLowerCase();
        const aliases = (card.dataset.aliases || '').toLowerCase();
        const usage = (card.dataset.usage || '').toLowerCase();
        const cat = card.dataset.cat;

        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQ =
          !q ||
          name.includes(q) ||
          desc.includes(q) ||
          aliases.includes(q) ||
          usage.includes(q);

        if (matchCat && matchQ) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visible === 0) {
        let e = document.getElementById('noResults');
        if (!e) {
          e = document.createElement('div');
          e.id = 'noResults';
          e.className = 'empty-box';
          e.innerHTML = `<div class="ico">🔍</div><h3>No commands found</h3><p>Try a different search or category.</p>`;
          grid.appendChild(e);
        }
      } else {
        const e = document.getElementById('noResults');
        if (e) e.remove();
      }
    }

    searchInput.addEventListener('input', filter);

    cats.addEventListener('click', (e) => {
      const btn = e.target.closest('.cat-btn');
      if (!btn) return;
      document.querySelectorAll('.cat-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.dataset.cat;
      filter();
    });

    // ============ CARD HOVER GLOW ============
    document.querySelectorAll('.cmd-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--x', `${e.clientX - r.left}px`);
        card.style.setProperty('--y', `${e.clientY - r.top}px`);
      });
    });

    // ============ STAGGER ANIMATION ============
    document.querySelectorAll('.cmd-card').forEach((card, i) => {
      card.style.animationDelay = `${Math.min(i * 0.02, 0.5)}s`;
    });
  </script>

</body>
</html>
