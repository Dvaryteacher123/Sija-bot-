<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - <%= botName %></title>
  <link rel="icon" href="/public/icons/favicon.ico" type="image/x-icon" />
  <style>
    :root {
      --bg-1: #0a0a1a;
      --accent-1: #7c3aed;
      --accent-2: #06b6d4;
      --accent-3: #ec4899;
      --err: #ef4444;
      --text: #f1f5f9;
      --text-dim: #94a3b8;
      --glass: rgba(255, 255, 255, 0.05);
      --glass-border: rgba(255, 255, 255, 0.12);
      --radius: 24px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-1);
      color: var(--text);
      overflow: hidden;
    }

    .bg-orbs {
      position: fixed; inset: 0; z-index: -1; overflow: hidden;
      background: radial-gradient(ellipse at top, #1a0b3d 0%, #0a0a1a 65%);
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.55; animation: float 20s ease-in-out infinite; }
    .orb-1 { width: 500px; height: 500px; background: radial-gradient(circle, #ef4444, transparent 70%); top: -160px; left: -140px; }
    .orb-2 { width: 440px; height: 440px; background: radial-gradient(circle, #7c3aed, transparent 70%); bottom: -140px; right: -140px; animation-delay: -8s; }
    .orb-3 { width: 360px; height: 360px; background: radial-gradient(circle, #ec4899, transparent 70%); top: 50%; left: 55%; animation-delay: -14s; }
    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(50px, -50px) scale(1.1); }
    }

    .wrap {
      display: grid;
      place-items: center;
      min-height: 100vh;
      padding: 40px 6vw;
    }

    .card {
      max-width: 620px;
      width: 100%;
      padding: 50px 40px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(24px);
      border-radius: var(--radius);
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
      animation: enter 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 15%; right: 15%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(239, 68, 68, 0.8), transparent);
    }

    @keyframes enter {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Animated glow behind number */
    .glow {
      position: absolute;
      top: 50%; left: 50%;
      width: 320px; height: 320px;
      transform: translate(-50%, -50%);
      background: radial-gradient(circle, rgba(239, 68, 68, 0.2), transparent 65%);
      filter: blur(30px);
      animation: pulseGlow 3s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes pulseGlow {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
      50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
    }

    .code {
      position: relative;
      font-size: clamp(4.5rem, 12vw, 7rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 1;
      margin-bottom: 18px;
      background: linear-gradient(135deg, #ef4444, #ec4899, #7c3aed);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: gradientShift 4s ease-in-out infinite;
      filter: drop-shadow(0 8px 30px rgba(239, 68, 68, 0.4));
    }
    @keyframes gradientShift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .icon-badge {
      display: inline-flex;
      width: 68px; height: 68px;
      border-radius: 20px;
      align-items: center; justify-content: center;
      font-size: 2rem;
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(124, 58, 237, 0.2));
      border: 1px solid rgba(239, 68, 68, 0.4);
      margin-bottom: 22px;
      animation: shakeIcon 3s ease-in-out infinite;
    }
    @keyframes shakeIcon {
      0%, 100% { transform: rotate(0deg); }
      10% { transform: rotate(-8deg); }
      20% { transform: rotate(8deg); }
      30% { transform: rotate(-6deg); }
      40% { transform: rotate(6deg); }
      50%, 100% { transform: rotate(0deg); }
    }

    h1 {
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    p.message {
      color: var(--text-dim);
      font-size: 1rem;
      line-height: 1.7;
      max-width: 480px;
      margin: 0 auto 32px;
    }

    .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 24px;
      border-radius: 13px;
      font-size: 0.94rem;
      font-weight: 600;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
      color: #fff;
      box-shadow: 0 10px 30px rgba(124, 58, 237, 0.45);
    }
    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(124, 58, 237, 0.6);
    }
    .btn-ghost {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text);
    }
    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateY(-3px);
      border-color: rgba(255, 255, 255, 0.25);
    }

    /* Details (dev only) */
    details {
      margin-top: 26px;
      text-align: left;
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 14px 18px;
      font-size: 0.82rem;
    }
    details summary {
      cursor: pointer;
      color: #c4b5fd;
      font-weight: 600;
      outline: none;
      user-select: none;
    }
    details pre {
      margin-top: 12px;
      padding: 12px;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 8px;
      overflow-x: auto;
      font-family: 'Courier New', monospace;
      font-size: 0.78rem;
      color: #fca5a5;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .footer-brand {
      margin-top: 30px;
      padding-top: 22px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 0.78rem;
      color: var(--text-dim);
      opacity: 0.7;
    }

    @media (max-width: 500px) {
      .card { padding: 36px 24px; }
      .actions { flex-direction: column; }
      .btn { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

  <div class="bg-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <div class="wrap">
    <div class="card">
      <div class="glow"></div>

      <div class="icon-badge">⚠️</div>

      <div class="code"><%= code || 500 %></div>

      <h1><%= title || 'Something went wrong' %></h1>

      <p class="message"><%= message || 'An unexpected error occurred. Please try again later.' %></p>

      <div class="actions">
        <a href="/" class="btn btn-primary">🏠 Go Home</a>
        <a href="javascript:history.back()" class="btn btn-ghost">← Go Back</a>
      </div>

      <% if (typeof stack !== 'undefined' && stack) { %>
        <details>
          <summary>🔍 Technical Details (dev only)</summary>
          <pre><%= stack %></pre>
        </details>
      <% } %>

      <div class="footer-brand">
        ⚡ <%= botName %> v<%= botVersion %> · <%= botFooter %>
      </div>
    </div>
  </div>

</body>
</html>
