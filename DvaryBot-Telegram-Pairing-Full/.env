# ===== Storage (local files, no MongoDB) =====
# DATA_DIR=./data

# ===== Speed / burst protection (menu fast, WhatsApp stays connected) =====
MENU_WITH_IMAGE=true
SEND_MIN_GAP_MS=30
SEND_MAX_QUEUE=1500
SEND_STALE_MS=120000
MESSAGE_CONCURRENCY=32

# ===== 24/7 STABILITY (700+ sessions) =====
# Empty = auto (75% of the server RAM). Or set a number in MB, e.g. 12000
NODE_MAX_HEAP_MB=
WA_LOG_LEVEL=silent
WA_STORE_LIMIT=40
FLOOD_MAX_COMMANDS=30
DB_FLUSH_MS=8000
SESSION_START_DELAY_MS=150
SESSION_SWEEP_MS=120000
WA_RECONNECT_MAX_MS=30000
FFMPEG_CONCURRENCY=3

SEND_CONCURRENCY=5

# Cache ya metadata ya group (sekunde 20) - inaharakisha antilink na amri za group
GROUP_META_TTL_MS=20000

# Menu: ujumbe wa kwanza kabla ya menu (acha MENU_LOADING_TEXT tupu kuuzima)
MENU_LOADING_TEXT=⏳ Dvary loading....
MENU_LOADING_DELAY_MS=500

# Urefu wa juu wa maelezo ya picha ya menu (ikiwa picha haitumwi, punguza hadi 1000)
MENU_CAPTION_MAX=3800

# ===== Diagnostics (washa ukitaka kuona kila ujumbe unaoingia kwenye console) =====
WA_DEBUG=false
WA_LOG_LEVEL=silent
