# Server
NODE_ENV=production
PORT=3000
BASE_URL=https://your-app.onrender.com


# Bot
BOT_NAME=DVARY BOT
BOT_VERSION=1.0.0
BOT_OWNER=Dvary
BOT_OWNER_NUMBER=255700000000
BOT_PREFIX=.
BOT_MODE=public
BOT_TIMEZONE=Africa/Dar_es_Salaam
BOT_FOOTER=Powered by Dvary

# Web session
SESSION_SECRET=change-this-to-a-long-random-secret
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-password

# Optional
LOG_LEVEL=info

# Telegram pairing
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
PAIR_ONLY=false

# Telegram FORCE JOIN (mtumiaji lazima ajoin haya kabla ya /pair au /qr)
# 1) Ongeza bot yako kama ADMIN kwenye kila kundi 3.
# 2) Tuma /chatid ndani ya kila kundi kupata Chat ID yake (mfano -1001234567890).
# 3) Bandika ID hizo hapa chini, kwa mpangilio uleule wa links.
# Ukiacha wazi, force-join itakuwa IMEZIMWA moja kwa moja.
TELEGRAM_FORCE_JOIN_LINKS=https://t.me/+BqmtkZTgbJ03Njc8,https://t.me/+t8XLd59jlE8xZmM0,https://t.me/+WAm8RNpPw6o5NjQ0
TELEGRAM_FORCE_JOIN_CHAT_IDS=

# Storage: everything is saved in local files under ./data (no MongoDB needed)
# Optional: change the folder (VPS/Pterodactyl: keep it on a persistent disk)
# DATA_DIR=./data

# ===== Speed / burst protection (menu fast, WhatsApp stays connected) =====
MENU_WITH_IMAGE=true
SEND_MIN_GAP_MS=130
SEND_MAX_QUEUE=400
SEND_STALE_MS=40000
MESSAGE_CONCURRENCY=16

# ===== Stability for ~400 sessions (Pterodactyl) =====
# NODE_MAX_HEAP_MB empty = automatic (75% of the server RAM). Or set MB manually, e.g. 12000
NODE_MAX_HEAP_MB=
WA_WATCHDOG_INTERVAL=180000
WA_WATCHDOG_GRACE_MS=360000
SESSION_START_DELAY_MS=500
SESSION_SWEEP_MS=120000

# ===== 24/7 stability additions =====
WA_LOG_LEVEL=silent
WA_STORE_LIMIT=40
FLOOD_MAX_COMMANDS=30
DB_FLUSH_MS=8000
WA_RECONNECT_MAX_MS=30000
FFMPEG_CONCURRENCY=3

# ---- Menu ----
# Ujumbe unaotumwa kwanza kabla ya menu
MENU_LOADING_TEXT=⏳ Dvary loading....
# Ucheleweshaji (ms) kati ya "loading" na menu
MENU_LOADING_DELAY_MS=700
# Idadi ya maonyo kabla ya kuondolewa (.warn)
WARN_LIMIT=3

# Ujumbe uliotumwa na bot unaokumbukwa kwa ajili ya retry (Waiting for this message)
WA_SENT_LIMIT=300

# Urefu wa juu wa maelezo ya picha ya menu (ikiwa picha haitumwi, punguza hadi 1000)
MENU_CAPTION_MAX=3800

# ===== Diagnostics (washa ukitaka kuona kila ujumbe unaoingia kwenye console) =====
WA_DEBUG=false
WA_LOG_LEVEL=silent
